# Note: https://inchpixels.pages.dev/* is 301-redirected via middleware for GSC domain migration.
# Do not add X-Robots-Tag: noindex to inchpixels.pages.dev as Google requires indexable 301s for Change of Address.

https://*.inchpixels.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Global security & performance headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Immutable caching for content-hashed Astro bundles (JS, CSS)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Caching for static imagery and assets
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
