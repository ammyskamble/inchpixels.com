---
import { languages, defaultLang, type SupportedLanguage } from '../i18n/ui';
import '../styles/global.css';

import { FAQ_DATA } from '../data/faqs';

interface Props {
  lang: SupportedLanguage;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const siteUrl = 'https://inchpixels.com';

// Normalize path to root equivalent (removes current /lang/ prefix if present)
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(es|ja|fr|de|pt|ko|it)(\/|$)/, '/') || '/';

function getLocalizedUrl(targetLocale: string): string {
  if (targetLocale === defaultLang) {
    return `${siteUrl}${cleanPath === '/' ? '' : cleanPath}`;
  }
  const suffix = cleanPath === '/' ? '' : cleanPath;
  return `${siteUrl}/${targetLocale}${suffix}`;
}

const canonicalUrl = getLocalizedUrl(lang);
const xDefaultUrl = getLocalizedUrl(defaultLang);
const ogImageUrl = 'https://inchpixels.com/og-image.svg';

// Combined JSON-LD Schema Graph (WebApplication + FAQPage)
const structuredDataGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'InchPixels - Inches to Pixels Converter',
      url: canonicalUrl,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'All',
      inLanguage: lang,
      description: description,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: FAQ_DATA.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RTDHDD2SY4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RTDHDD2SY4');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {Object.keys(languages).map((locale) => (
          <link
            rel="alternate"
            hreflang={locale}
            href={getLocalizedUrl(locale)}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="InchPixels" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Synchronous Theme Script (FOUC Prevention & System Preference Sync) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const mql = window.matchMedia('(prefers-color-scheme: dark)');
          if (stored === 'dark' || (!stored && mql.matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          // Respond dynamically to OS theme changes if user hasn't set an explicit preference
          mql.addEventListener('change', function(e) {
            if (!localStorage.getItem('theme')) {
              if (e.matches) {
                document.documentElement.classList.add('dark');
              } else {
                document.documentElement.classList.remove('dark');
              }
            }
          });
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts Preconnect, DNS-Prefetch & Non-blocking Asynchronous Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <!-- Favicon & Web App Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="InchPixlet" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data JSON-LD (suppressed on noindex/error pages) -->
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredDataGraph)} />
    )}

    <slot name="head" />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col selection:bg-primary/20 selection:text-primary">
    <div class="min-h-screen flex flex-col relative overflow-x-hidden">
      <!-- Subtle Technical Blueprint Dot Grid with Smooth Radial Mask -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40 dark:opacity-20 [mask-image:radial-gradient(ellipse_80%_60%_at_50%_15%,#000_50%,transparent_100%)] pointer-events-none -z-20 transition-opacity duration-300"></div>

      <!-- Smooth Ambient Radial Glow Accent (Light Mode) -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-[680px] bg-[radial-gradient(ellipse_75%_55%_at_50%_-5%,oklch(0.52_0.22_260_/_14%),transparent_70%)] opacity-100 dark:opacity-0 blur-2xl pointer-events-none -z-10 transition-opacity duration-300"></div>

      <!-- Smooth Ambient Radial Glow Accent (Dark Mode) -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-[680px] bg-[radial-gradient(ellipse_75%_55%_at_50%_-5%,oklch(0.65_0.22_255_/_16%),transparent_70%)] opacity-0 dark:opacity-100 blur-2xl pointer-events-none -z-10 transition-opacity duration-300"></div>
      
      <slot />
    </div>
  </body>
</html>
