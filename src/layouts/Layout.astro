---
import { languages, defaultLang, type SupportedLanguage } from '../i18n/ui';
import '../styles/global.css';

import { FAQ_DATA } from '../data/faqs';

interface Props {
  lang: SupportedLanguage;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const siteUrl = 'https://inchpixels.com';

// Normalize path to root equivalent (removes current /lang/ prefix if present)
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(es|ja|fr|de|pt|ko|it)(\/|$)/, '/') || '/';

function getLocalizedUrl(targetLocale: string): string {
  if (targetLocale === defaultLang) {
    return `${siteUrl}${cleanPath === '/' ? '' : cleanPath}`;
  }
  const suffix = cleanPath === '/' ? '' : cleanPath;
  return `${siteUrl}/${targetLocale}${suffix}`;
}

const canonicalUrl = getLocalizedUrl(lang);
const xDefaultUrl = getLocalizedUrl(defaultLang);
const ogImageUrl = 'https://inchpixels.com/og-image.svg';

// Combined JSON-LD Schema Graph (WebApplication + FAQPage)
const structuredDataGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#webapp`,
      name: 'InchPixels - Inches to Pixels Converter',
      url: canonicalUrl,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'All',
      inLanguage: lang,
      description: description,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: FAQ_DATA.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RTDHDD2SY4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RTDHDD2SY4');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO: hreflang tags for all 8 supported languages -->
    {Object.keys(languages).map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={getLocalizedUrl(locale)}
      />
    ))}
    <!-- Fallback default -->
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="InchPixels" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Synchronous Theme Script (FOUC Prevention) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%236366f1'/><text x='50%' y='55%' dominant-baseline='middle' text-anchor='middle' font-family='monospace' font-size='46' font-weight='bold' fill='white'>IN</text></svg>" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredDataGraph)} />

    <slot name="head" />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col selection:bg-primary/20 selection:text-primary transition-colors duration-200">
    <div class="min-h-screen flex flex-col relative overflow-x-hidden">
      <!-- Subtle Technical Blueprint Dot Grid with Smooth Radial Mask -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40 dark:opacity-20 [mask-image:radial-gradient(ellipse_80%_60%_at_50%_15%,#000_50%,transparent_100%)] pointer-events-none -z-20"></div>

      <!-- Smooth Ambient Radial Glow Accent (Extended smoothly past calculator) -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-[680px] bg-[radial-gradient(ellipse_75%_55%_at_50%_-5%,oklch(0.52_0.22_260_/_14%),transparent_70%)] dark:bg-[radial-gradient(ellipse_75%_55%_at_50%_-5%,oklch(0.65_0.22_255_/_16%),transparent_70%)] blur-2xl pointer-events-none -z-10"></div>
      
      <slot />
    </div>
  </body>
</html>
