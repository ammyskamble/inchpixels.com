---
/**
 * BlogPost.astro
 * Full-page layout for long-form educational blog articles.
 * Wraps Layout.astro and injects Article, Breadcrumb, and FAQPage JSON-LD schema.
 */
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SupportedLanguage } from '../i18n/ui';
import { getCollection } from 'astro:content';

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  lang?: SupportedLanguage;
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: number;
  faqs?: FAQ[];
  tags?: string[];
  cluster?: string;
}

const {
  lang = 'en',
  title,
  description,
  publishDate,
  updatedDate,
  author = 'InchPixels Team',
  readingTime,
  faqs = [],
  tags = [],
} = Astro.props;

const siteUrl = 'https://inchpixels.com';
const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;
const ogImageUrl = `${siteUrl}/og-image.svg`;

const allBlogPosts = await getCollection('blog');
const currentSlug = normalizedPath.replace(/^\/blog\//, '').replace(/\/$/, '');
const relatedBlogPosts = allBlogPosts
  .filter((p) => p.id !== currentSlug)
  .slice(0, 3);

const formattedPublish = publishDate.toISOString();
const formattedUpdated = (updatedDate ?? publishDate).toISOString();

// Article JSON-LD
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonicalUrl,
  datePublished: formattedPublish,
  dateModified: formattedUpdated,
  author: {
    '@type': 'Organization',
    name: 'InchPixels',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'InchPixels',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  image: ogImageUrl,
  inLanguage: lang,
  keywords: tags.join(', '),
};

// FAQPage JSON-LD (only when FAQs present)
const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.a,
          },
        })),
      }
    : null;

// Breadcrumb JSON-LD
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};

const displayDate = (updatedDate ?? publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  lang={lang}
  title={`${title} | InchPixels`}
  description={description}
  ogType="article"
  ogImage={ogImageUrl}
  articleMeta={{
    publishedTime: formattedPublish,
    modifiedTime: formattedUpdated,
    author: author,
    tags: tags,
  }}
  customSchema={true}
  hreflang={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header />

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted-foreground mb-8 font-medium">
      <a href="https://inchpixels.com/" class="hover:text-primary transition-colors">Home</a>
      <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="https://inchpixels.com/blog/" class="hover:text-primary transition-colors">Blog</a>
      <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-foreground line-clamp-1">{title}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-border/60">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-[1.18] text-foreground mb-5">
        {title}
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed mb-6 max-w-2xl">
        {description}
      </p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          {author}
        </span>
        <span class="text-border">•</span>
        <time datetime={formattedPublish} class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          {displayDate}
        </time>
        {readingTime && (
          <>
            <span class="text-border">•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {readingTime} min read
            </span>
          </>
        )}
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-5">
          {tags.map((tag) => (
            <span class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Article Content -->
    <article class="article-prose">
      <slot />
    </article>

    <!-- Back-to-tool CTA -->
    <div class="mt-16 p-6 rounded-2xl bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20 text-center">
      <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">Try it yourself</p>
      <p class="text-foreground font-bold text-xl mb-1">Free Inches ↔ Pixels Converter</p>
      <p class="text-muted-foreground text-sm mb-5">Convert any dimension at any DPI instantly — no sign-up required.</p>
      <a
        href="https://inchpixels.com/#converter"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-opacity shadow-lg shadow-primary/25 cursor-pointer"
      >
        Open Converter
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <!-- Related Articles -->
    {relatedBlogPosts.length > 0 && (
      <div class="mt-16 pt-10 border-t border-border/70">
        <div class="flex items-center justify-between mb-6">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary">Explore More</span>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground m-0">Related Guides & Deep Dives</h2>
          </div>
          <a href="/blog/" class="text-xs font-semibold text-primary hover:underline">
            All Articles →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedBlogPosts.map((rel) => (
            <a
              href={`/blog/${rel.id}/`}
              class="p-4 rounded-xl bg-card border border-border/80 hover:border-primary/50 hover:shadow-md transition-all flex flex-col justify-between gap-3 group"
            >
              <div class="flex flex-col gap-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-primary">
                  {rel.data.cluster || 'Guide'}
                </span>
                <h3 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors line-clamp-2 m-0">
                  {rel.data.title}
                </h3>
                <p class="text-xs text-muted-foreground line-clamp-2 m-0">
                  {rel.data.description}
                </p>
              </div>
              <span class="text-xs text-primary font-medium inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                Read guide →
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </main>

  <Footer lang={lang} />
</Layout>

<style is:global>
  /* =============================================
     BLOG ARTICLE PROSE STYLES (Global for slotted MDX)
     ============================================= */

  .article-prose {
    color: var(--foreground);
    line-height: 1.8;
    font-size: 1.0625rem;
  }

  .article-prose h2 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin-top: 2.5rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
    scroll-margin-top: 5rem;
  }

  .article-prose h3 {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin-top: 2rem;
    margin-bottom: 0.65rem;
    scroll-margin-top: 5rem;
  }

  .article-prose h4 {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--muted-foreground);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-prose p {
    margin-bottom: 1.35rem;
    color: var(--foreground);
  }

  .article-prose ul,
  .article-prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
  }

  .article-prose ul { list-style: disc; }
  .article-prose ol { list-style: decimal; }

  .article-prose li {
    margin-bottom: 0.45rem;
    line-height: 1.75;
  }

  .article-prose li::marker {
    color: var(--primary);
  }

  .article-prose strong {
    font-weight: 650;
    color: var(--foreground);
  }

  .article-prose em {
    font-style: italic;
    color: var(--muted-foreground);
  }

  .article-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--muted);
    color: var(--primary);
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    padding: 0.15em 0.4em;
  }

  .article-prose pre {
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }

  .article-prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--foreground);
    font-size: inherit;
  }

  .article-prose blockquote {
    border-left: 3px solid var(--primary);
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    color: var(--muted-foreground);
    font-style: italic;
    font-size: 1.05rem;
  }

  .article-prose a {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition: opacity 0.15s;
  }

  .article-prose a:hover { opacity: 0.75; }

  .article-prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  /* Responsive, cleanly styled Markdown Tables */
  .article-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    display: table;
  }

  @media (max-width: 640px) {
    .article-prose table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }
  }

  .article-prose th {
    background-color: var(--muted);
    color: var(--foreground);
    font-weight: 650;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--border);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .article-prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .article-prose tr:last-child td {
    border-bottom: none;
  }

  .article-prose tr:hover td {
    background-color: var(--muted);
  }

  /* Table of Contents */
  .toc-container {
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .toc-container nav ol {
    list-style: decimal;
    padding-left: 1.25rem;
    margin: 0.5rem 0 0;
  }

  .toc-container nav li {
    margin-bottom: 0.3rem;
    font-size: 0.9rem;
    color: var(--muted-foreground);
  }

  .toc-container nav a {
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s;
  }

  .toc-container nav a:hover {
    color: var(--primary);
  }
</style>
