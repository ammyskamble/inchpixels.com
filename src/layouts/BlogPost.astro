---
/**
 * BlogPost.astro
 * Full-page layout for long-form educational blog articles.
 * Injects Article + optional FAQPage JSON-LD schema automatically.
 */
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SupportedLanguage } from '../i18n/ui';
import { getHreflangLinks } from '../i18n/utils';

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  lang?: SupportedLanguage;
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: number;
  faqs?: FAQ[];
  tags?: string[];
  cluster?: string;
}

const {
  lang = 'en',
  title,
  description,
  publishDate,
  updatedDate,
  author = 'InchPixels Team',
  readingTime,
  faqs = [],
  tags = [],
} = Astro.props;

const siteUrl = 'https://inchpixels.com';
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = `${siteUrl}/og-image.svg`;

const formattedPublish = publishDate.toISOString();
const formattedUpdated = (updatedDate ?? publishDate).toISOString();

// Article JSON-LD
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonicalUrl,
  datePublished: formattedPublish,
  dateModified: formattedUpdated,
  author: {
    '@type': 'Organization',
    name: 'InchPixels',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'InchPixels',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  image: ogImageUrl,
  inLanguage: lang,
  keywords: tags.join(', '),
};

// FAQPage JSON-LD (only when FAQs present)
const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.a,
          },
        })),
      }
    : null;

// Breadcrumb JSON-LD
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};

const hreflangLinks = getHreflangLinks(Astro.url);

const displayDate = (updatedDate ?? publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RTDHDD2SY4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RTDHDD2SY4');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | InchPixels</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {hreflangLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={entry.url} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | InchPixels`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="InchPixels" />
    <meta property="article:published_time" content={formattedPublish} />
    <meta property="article:modified_time" content={formattedUpdated} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | InchPixels`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme FOUC Prevention -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const mql = window.matchMedia('(prefers-color-scheme: dark)');
          if (stored === 'dark' || (!stored && mql.matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          mql.addEventListener('change', function(e) {
            if (!localStorage.getItem('theme')) {
              if (e.matches) { document.documentElement.classList.add('dark'); }
              else { document.documentElement.classList.remove('dark'); }
            }
          });
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="InchPixels" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <slot name="head" />

    <style>
      /* =============================================
         BLOG ARTICLE PROSE STYLES
         ============================================= */

      /* Import global styles */
      @import '../styles/global.css';

      .article-prose {
        color: var(--foreground);
        line-height: 1.8;
        font-size: 1.0625rem;
      }

      .article-prose h2 {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--foreground);
        margin-top: 2.5rem;
        margin-bottom: 0.875rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--border);
        scroll-margin-top: 5rem;
      }

      .article-prose h3 {
        font-size: 1.2rem;
        font-weight: 650;
        color: var(--foreground);
        margin-top: 2rem;
        margin-bottom: 0.6rem;
        scroll-margin-top: 5rem;
      }

      .article-prose h4 {
        font-size: 1.05rem;
        font-weight: 650;
        color: var(--muted-foreground);
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.8rem;
      }

      .article-prose p {
        margin-bottom: 1.35rem;
      }

      .article-prose ul,
      .article-prose ol {
        padding-left: 1.5rem;
        margin-bottom: 1.35rem;
      }

      .article-prose ul { list-style: disc; }
      .article-prose ol { list-style: decimal; }

      .article-prose li {
        margin-bottom: 0.4rem;
        line-height: 1.75;
      }

      .article-prose li::marker {
        color: var(--primary);
      }

      .article-prose strong {
        font-weight: 650;
        color: var(--foreground);
      }

      .article-prose em {
        font-style: italic;
        color: var(--muted-foreground);
      }

      .article-prose code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background-color: var(--muted);
        color: var(--primary);
        border: 1px solid var(--border);
        border-radius: 0.3rem;
        padding: 0.15em 0.4em;
      }

      .article-prose pre {
        background-color: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        line-height: 1.6;
      }

      .article-prose pre code {
        background: none;
        border: none;
        padding: 0;
        color: var(--foreground);
        font-size: inherit;
      }

      .article-prose blockquote {
        border-left: 3px solid var(--primary);
        padding-left: 1.25rem;
        margin: 1.75rem 0;
        color: var(--muted-foreground);
        font-style: italic;
        font-size: 1.05rem;
      }

      .article-prose a {
        color: var(--primary);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
        transition: opacity 0.15s;
      }

      .article-prose a:hover { opacity: 0.75; }

      .article-prose hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }

      /* Table of Contents */
      .toc-container {
        background-color: var(--card);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2.5rem;
      }

      .toc-container nav ol {
        list-style: decimal;
        padding-left: 1.25rem;
        margin: 0.5rem 0 0;
      }

      .toc-container nav li {
        margin-bottom: 0.3rem;
        font-size: 0.9rem;
        color: var(--muted-foreground);
      }

      .toc-container nav a {
        color: var(--muted-foreground);
        text-decoration: none;
        transition: color 0.15s;
      }

      .toc-container nav a:hover {
        color: var(--primary);
      }
    </style>
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <div class="min-h-screen flex flex-col relative overflow-x-hidden">
      <!-- Blueprint Grid -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40 dark:opacity-20 [mask-image:radial-gradient(ellipse_80%_60%_at_50%_15%,#000_50%,transparent_100%)] pointer-events-none -z-20 transition-opacity duration-250"></div>
      <!-- Glow (light) -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[640px] bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,oklch(0.52_0.22_260_/_7%),transparent_75%)] opacity-100 dark:opacity-0 blur-2xl pointer-events-none -z-10"></div>
      <!-- Glow (dark) -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[640px] bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,oklch(0.65_0.22_255_/_15%),transparent_75%)] opacity-0 dark:opacity-100 blur-2xl pointer-events-none -z-10"></div>

      <Header />

      <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">

        <!-- Breadcrumb Nav -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted-foreground mb-8 font-medium">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
          <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-foreground line-clamp-1">{title}</span>
        </nav>

        <!-- Article Header -->
        <header class="mb-10 pb-8 border-b border-border/60">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-[1.18] text-foreground mb-5">
            {title}
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6 max-w-2xl">
            {description}
          </p>
          <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              {author}
            </span>
            <span class="text-border">•</span>
            <time datetime={formattedPublish} class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              {displayDate}
            </time>
            {readingTime && (
              <>
                <span class="text-border">•</span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {readingTime} min read
                </span>
              </>
            )}
          </div>
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-5">
              {tags.map((tag) => (
                <span class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- Article Content -->
        <article class="article-prose">
          <slot />
        </article>

        <!-- Back-to-tool CTA -->
        <div class="mt-16 p-6 rounded-2xl bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20 text-center">
          <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">Try it yourself</p>
          <p class="text-foreground font-bold text-xl mb-1">Free Inches ↔ Pixels Converter</p>
          <p class="text-muted-foreground text-sm mb-5">Convert any dimension at any DPI instantly — no sign-up required.</p>
          <a
            href="/#converter"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-opacity shadow-lg shadow-primary/25"
          >
            Open Converter
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- More Articles -->
        <div class="mt-12 pt-8 border-t border-border/60">
          <p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-4">Continue Reading</p>
          <a href="/blog" class="inline-flex items-center gap-2 text-sm text-primary font-medium hover:opacity-75 transition-opacity">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            View all guides & articles
          </a>
        </div>

      </main>

      <Footer lang={lang} />
    </div>

    <script>
      function initThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        if (!toggleBtn || toggleBtn.dataset.themeInitialized === 'true') return;
        toggleBtn.dataset.themeInitialized = 'true';

        let transitionTimeout: ReturnType<typeof setTimeout> | null = null;

        const updateAria = (isDark: boolean) => {
          toggleBtn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          toggleBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        };

        updateAria(document.documentElement.classList.contains('dark'));

        const handleToggle = () => {
          const isDarkNow = document.documentElement.classList.contains('dark');
          const targetDark = !isDarkNow;

          document.documentElement.classList.add('theme-transitioning');

          if (targetDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }

          try { localStorage.setItem('theme', targetDark ? 'dark' : 'light'); } catch {}

          updateAria(targetDark);

          if (transitionTimeout) clearTimeout(transitionTimeout);
          transitionTimeout = setTimeout(() => {
            document.documentElement.classList.remove('theme-transitioning');
          }, 280);
        };

        toggleBtn.addEventListener('click', handleToggle);
      }

      initThemeToggle();
      document.addEventListener('astro:page-load', initThemeToggle);
    </script>
  </body>
</html>
