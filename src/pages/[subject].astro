---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubjectPageContent from '../components/SubjectPageContent.astro';
import { SUBJECTS, type SubjectItem } from '../data/subjects';

export function getStaticPaths() {
  return SUBJECTS.map((subject) => ({
    params: { subject: subject.slug },
    props: { subject },
  }));
}

interface Props {
  subject: SubjectItem;
}

const { subject } = Astro.props;
const lang = 'en';

// Breadcrumb structured data
const siteUrl = 'https://inchpixels.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: subject.name,
      item: `${siteUrl}/${subject.slug}`,
    },
  ],
};
---

<Layout
  lang={lang}
  title={subject.metaTitle}
  description={subject.metaDesc}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main class="flex-1 w-full pb-16">
    <SubjectPageContent subject={subject} lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
