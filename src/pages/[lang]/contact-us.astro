---
import Layout from '../../layouts/Layout.astro';
import LanguagePicker from '../../components/LanguagePicker.astro';
import Footer from '../../components/Footer.astro';
import ContactUsContent from '../../components/info/ContactUsContent.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<Layout
  lang={lang}
  title="Contact Us | InchPixels"
  description="Contact the InchPixels team for feature requests, preset suggestions, bug reports, and partnership inquiries."
>
  <header class="p-4 flex justify-end max-w-7xl mx-auto w-full">
    <LanguagePicker currentLang={lang} />
  </header>

  <main class="flex-1 w-full">
    <ContactUsContent lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
