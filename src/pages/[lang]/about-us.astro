---
import Layout from '../../layouts/Layout.astro';
import LanguagePicker from '../../components/LanguagePicker.astro';
import Footer from '../../components/Footer.astro';
import AboutUsContent from '../../components/info/AboutUsContent.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<Layout
  lang={lang}
  title="About Us | InchPixels"
  description="Learn about InchPixels, the mission behind our instant inches-to-pixels converter, and our commitment to precision creative engineering."
>
  <header class="p-4 flex justify-end max-w-7xl mx-auto w-full">
    <LanguagePicker currentLang={lang} />
  </header>

  <main class="flex-1 w-full">
    <AboutUsContent lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
