---
/**
 * /blog/index.astro
 * Blog listing page — shows all published articles sorted by date.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const clusterMeta = {
  conceptual: { label: 'Conceptual & Educational', color: 'bg-primary/10 text-primary border-primary/20', icon: '🧠' },
  'how-to':   { label: 'How-To Guides',             color: 'bg-success/10 text-success border-success/20',   icon: '🛠️' },
  industry:   { label: 'Industry Reference',         color: 'bg-cyan-glow/10 text-cyan-glow border-cyan-glow/20', icon: '📚' },
};
---

<Layout
  lang={lang}
  title="DPI, Pixels & Print Design Blog | InchPixels"
  description="Deep-dive guides on DPI vs PPI, print-ready design, CSS pixel grids, and photography print sizes. Educational content for designers, developers, and photographers."
>
  <Header />

  <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">

    <!-- Hero -->
    <section class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-5">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        Educational Guides & Deep Dives
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground leading-tight mb-4">
        Learn DPI, Pixels & Print Design
      </h1>
      <p class="text-muted-foreground text-base sm:text-lg leading-relaxed">
        From understanding the difference between DPI and PPI to setting up print-ready canvases in Photoshop — comprehensive, jargon-free guides written for everyone.
      </p>
    </section>

    <!-- Article Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => {
          const cluster = clusterMeta[post.data.cluster] ?? clusterMeta.conceptual;
          const displayDate = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
          });
          return (
            <article class="group flex flex-col bg-card border border-border rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-primary/30 transition-all duration-200">
              <!-- Card Top Accent -->
              <div class="h-1.5 bg-gradient-to-r from-primary to-cyan-glow opacity-60 group-hover:opacity-100 transition-opacity"></div>

              <div class="flex flex-col flex-1 p-6">
                <!-- Cluster Badge -->
                <div class="flex items-center gap-2 mb-4">
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-semibold rounded-full border ${cluster.color}`}>
                    <span>{cluster.icon}</span>
                    {cluster.label}
                  </span>
                </div>

                <h2 class="font-bold text-lg text-foreground leading-snug mb-3 group-hover:text-primary transition-colors line-clamp-3">
                  <a href={`/blog/${post.id}`} class="stretched-link after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-sm text-muted-foreground leading-relaxed flex-1 line-clamp-3 mb-5">
                  {post.data.description}
                </p>

                <!-- Footer Meta -->
                <div class="flex items-center justify-between text-xs text-muted-foreground mt-auto pt-4 border-t border-border/60">
                  <time datetime={post.data.publishDate.toISOString()}>{displayDate}</time>
                  {post.data.readingTime && (
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      {post.data.readingTime} min read
                    </span>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-20 text-muted-foreground">
        <p class="text-4xl mb-4">📝</p>
        <p class="font-semibold text-foreground mb-2">Articles coming soon</p>
        <p class="text-sm">We're writing in-depth guides. Check back shortly.</p>
      </div>
    )}

    <!-- Back to tool -->
    <div class="mt-16 text-center">
      <a
        href="/#converter"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-opacity shadow-lg shadow-primary/25"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Open the Free Converter
      </a>
    </div>

  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .stretched-link { position: relative; }
</style>
