---
/**
 * /blog/[slug].astro
 * Dynamic route that renders each MDX blog article through BlogPost layout.
 */
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import FAQBlock from '../../components/blog/FAQBlock.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  readingTime={post.data.readingTime}
  faqs={post.data.faqs}
  tags={post.data.tags}
  cluster={post.data.cluster}
>
  <Content />

  {post.data.faqs && post.data.faqs.length > 0 && (
    <FAQBlock faqs={post.data.faqs} />
  )}
</BlogPost>
