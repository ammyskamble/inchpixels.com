---
/**
 * ErrorPageContent.astro
 * Standardized, high-aesthetic error page canvas for 404 (Not Found) and 500 (Server Error).
 * Follows DESIGN.md tokens, glassmorphism, responsive buttons, and localized routing.
 */
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  errorCode: 404 | 500;
  lang: SupportedLanguage;
}

const { errorCode, lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const is404 = errorCode === 404;
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 flex flex-col items-center text-center">
  {/* Error Status Badge */}
  <div
    class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-6 animate-in fade-in duration-300 ${
      is404
        ? 'bg-primary/10 text-primary border border-primary/20'
        : 'bg-red-500/10 text-red-500 border border-red-500/20'
    }`}
  >
    <span class={`w-2 h-2 rounded-full animate-pulse ${is404 ? 'bg-primary' : 'bg-red-500'}`}></span>
    <span>{is404 ? t('error.404.badge') : t('error.500.badge')}</span>
  </div>

  {/* Giant Gradient Numeric Code */}
  <div class="relative select-none my-3">
    <span
      class={`font-mono font-black tracking-tighter bg-clip-text text-transparent block ${
        is404
          ? 'bg-gradient-to-br from-primary via-cyan-glow to-primary'
          : 'bg-gradient-to-br from-red-500 via-amber-400 to-primary'
      }`}
      style="font-size: clamp(5rem, 15vw, 8.5rem); line-height: 1;"
    >
      {errorCode}
    </span>
  </div>

  {/* Heading & Explanation */}
  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground max-w-xl leading-tight">
    {is404 ? t('error.404.heading') : t('error.500.heading')}
  </h1>

  <p class="text-sm sm:text-base text-muted-foreground mt-4 max-w-lg leading-relaxed">
    {is404 ? t('error.404.desc') : t('error.500.desc')}
  </p>

  {/* Interactive Call to Action Buttons */}
  <div class="flex flex-wrap items-center justify-center gap-3.5 mt-8">
    <a
      href={translatePath('/')}
      class="px-5 py-3 rounded-xl bg-gradient-to-r from-primary to-cyan-glow text-primary-foreground font-bold text-sm shadow-md shadow-primary/25 hover:opacity-95 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
        ></path>
      </svg>
      <span>{t('error.btn.home')}</span>
    </a>

    {is404 ? (
      <a
        href={`${translatePath('/')}#reference-tables`}
        class="px-5 py-3 rounded-xl border border-border bg-card/80 hover:bg-muted text-foreground font-semibold text-sm transition-all flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
        <span>{t('error.btn.tables')}</span>
      </a>
    ) : (
      <button
        type="button"
        onclick="window.location.reload()"
        class="px-5 py-3 rounded-xl border border-border bg-card/80 hover:bg-muted text-foreground font-semibold text-sm transition-all flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          ></path>
        </svg>
        <span>{t('error.btn.retry')}</span>
      </button>
    )}
  </div>

  {/* Quick Destination Cards */}
  <div class="w-full max-w-md mt-12 text-left bg-card border border-border/80 rounded-2xl p-5 shadow-xs">
    <div class="flex items-center justify-between pb-3 border-b border-border/60 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-foreground">
        {t('error.links.title')}
      </span>
      <span class="text-[10px] font-mono text-muted-foreground">inchpixels.com</span>
    </div>

    <div class="flex flex-col gap-1 text-xs">
      <a
        href={translatePath('/')}
        class="flex items-center justify-between p-2 rounded-lg hover:bg-muted transition-colors text-muted-foreground hover:text-foreground font-medium group"
      >
        <div class="flex items-center gap-2">
          <span>⚡</span>
          <span>1D & 2D Inches ↔ Pixels Converter</span>
        </div>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-primary">→</span>
      </a>

      <a
        href={`${translatePath('/')}#reference-tables`}
        class="flex items-center justify-between p-2 rounded-lg hover:bg-muted transition-colors text-muted-foreground hover:text-foreground font-medium group"
      >
        <div class="flex items-center gap-2">
          <span>📊</span>
          <span>Print & Screen Conversion Tables (1–100")</span>
        </div>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-primary">→</span>
      </a>

      <a
        href={`${translatePath('/')}#guides`}
        class="flex items-center justify-between p-2 rounded-lg hover:bg-muted transition-colors text-muted-foreground hover:text-foreground font-medium group"
      >
        <div class="flex items-center gap-2">
          <span>📚</span>
          <span>DPI vs. PPI Mathematical Resolution Guide</span>
        </div>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-primary">→</span>
      </a>

      <a
        href={`${translatePath('/')}#faq`}
        class="flex items-center justify-between p-2 rounded-lg hover:bg-muted transition-colors text-muted-foreground hover:text-foreground font-medium group"
      >
        <div class="flex items-center gap-2">
          <span>❓</span>
          <span>{t('faq.heading')}</span>
        </div>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-primary">→</span>
      </a>

      <a
        href={translatePath('/contact-us')}
        class="flex items-center justify-between p-2 rounded-lg hover:bg-muted transition-colors text-muted-foreground hover:text-foreground font-medium group"
      >
        <div class="flex items-center gap-2">
          <span>💬</span>
          <span>Contact & Support</span>
        </div>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-primary">→</span>
      </a>
    </div>
  </div>
</div>
