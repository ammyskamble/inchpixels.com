---
/**
 * Header.astro
 * Glassmorphic navigation bar with logo, anchors, language picker, and theme switcher.
 */
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-background/80 border-b border-border/70 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary to-cyan-glow flex items-center justify-center text-primary-foreground shadow-md shadow-primary/20 group-hover:scale-105 transition-transform">
        <span class="font-mono font-black text-sm tracking-tighter">IN/PX</span>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-foreground flex items-center gap-1">
          InchPixels<span class="text-primary">.com</span>
        </span>
        <span class="text-[10px] font-medium text-muted-foreground -mt-1 hidden sm:inline">
          {t('calc.subheading')}
        </span>
      </div>
    </a>

    {/* Center Navigation Links */}
    <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-muted-foreground">
      <a href="#converter" class="hover:text-foreground transition-colors">Calculator</a>
      <a href="#reference-tables" class="hover:text-foreground transition-colors">Tables</a>
      <a href="#guides" class="hover:text-foreground transition-colors">Guide</a>
      <a href="#faq" class="hover:text-foreground transition-colors">{t('faq.heading')}</a>
    </nav>

    {/* Right Header Actions */}
    <div class="flex items-center gap-2.5">
      {/* Target DPI Badges */}
      <div class="hidden lg:flex items-center gap-1.5 text-[11px] font-mono font-semibold text-muted-foreground bg-muted/40 px-2.5 py-1 rounded-full border border-border/50">
        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
        <span>300 DPI Print</span>
        <span class="opacity-40">•</span>
        <span>96 DPI Web</span>
      </div>

      {/* Language Picker Dropdown */}
      <LanguagePicker currentLang={lang} />

      {/* Dark / Light Mode Toggle Button */}
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle dark and light mode"
        class="p-2 rounded-xl border border-border bg-card/60 hover:bg-muted text-muted-foreground hover:text-foreground transition-all focus:outline-none focus:ring-2 focus:ring-primary/40"
      >
        {/* Sun Icon (shown in dark mode) */}
        <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        {/* Moon Icon (shown in light mode) */}
        <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Handler
  const toggleBtn = document.getElementById('theme-toggle-btn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {}
    });
  }
</script>
