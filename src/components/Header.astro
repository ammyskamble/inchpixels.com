---
/**
 * Header.astro
 * Glassmorphic navigation bar with logo, localized anchors, language picker,
 * theme switcher, and responsive mobile navigation drawer.
 */
import LanguagePicker from './LanguagePicker.astro';
import LogoIcon from './LogoIcon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
const isHomePage = pathname === '/' || /^\/(es|ja|fr|de|pt|ko|it)\/?$/.test(pathname);
const isBlog = pathname.startsWith('/blog');

// Use origin-agnostic root-relative paths for internal navigation
const homePath = lang === 'en' ? '/' : `/${lang}/`;
const blogPath = '/blog/';

const calcUrl = isHomePage ? '#converter' : `${homePath}#converter`;
const subjectsUrl = isHomePage ? '#subjects' : `${homePath}#subjects`;
const tablesUrl = isHomePage ? '#reference-tables' : `${homePath}#reference-tables`;
const guidesUrl = isHomePage ? '#guides' : `${homePath}#guides`;
const faqUrl = isHomePage ? '#faq' : `${homePath}#faq`;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-background/80 border-b border-border/70 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href={homePath} class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl shadow-md shadow-primary/20 group-hover:scale-105 transition-transform flex-shrink-0">
        <LogoIcon class="w-full h-full" />
      </div>
      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-foreground flex items-center gap-1">
          InchPixels<span class="text-primary">.com</span>
        </span>
        <span class="text-[10px] font-medium text-muted-foreground -mt-1 hidden sm:inline">
          {t('calc.subheading')}
        </span>
      </div>
    </a>

    {/* Center Navigation Links (Desktop) */}
    <nav class="hidden md:flex items-center gap-5 lg:gap-6 text-xs font-semibold text-muted-foreground" aria-label="Main navigation">
      <a href={calcUrl} class="hover:text-foreground transition-colors py-1">{t('nav.calc')}</a>
      <a href={subjectsUrl} class="hover:text-foreground transition-colors py-1">{t('nav.subjects')}</a>
      <a href={tablesUrl} class="hover:text-foreground transition-colors py-1">{t('nav.tables')}</a>
      <a href={guidesUrl} class="hover:text-foreground transition-colors py-1">{t('nav.guides')}</a>
      <a href={blogPath} class={`hover:text-foreground transition-colors py-1 ${isBlog ? 'text-primary font-bold' : ''}`}>{t('nav.blog')}</a>
      <a href={faqUrl} class="hover:text-foreground transition-colors py-1 whitespace-nowrap">{t('nav.faq')}</a>
    </nav>

    {/* Right Header Actions */}
    <div class="flex items-center gap-2 sm:gap-2.5">
      {/* Target DPI Badges (Desktop) */}
      <div class="hidden lg:flex items-center gap-1.5 text-[11px] font-mono font-semibold text-muted-foreground bg-muted/40 px-2.5 py-1 rounded-full border border-border/50">
        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
        <span>300 DPI Print</span>
        <span class="opacity-40">•</span>
        <span>96 DPI Web</span>
      </div>

      {/* Language Picker Dropdown */}
      <LanguagePicker currentLang={lang} />

      {/* Dark / Light Mode Toggle Button */}
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle dark and light mode"
        class="relative p-2 rounded-xl border border-border bg-card/60 hover:bg-muted text-muted-foreground hover:text-foreground transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer active:scale-95"
      >
        <span class="relative block w-4 h-4 overflow-hidden">
          {/* Sun Icon (rotates and scales in dark mode) */}
          <svg
            id="theme-sun"
            class="absolute inset-0 w-4 h-4 text-amber-400 origin-center transition-all duration-250 ease-out scale-0 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          {/* Moon Icon (rotates and scales in light mode) */}
          <svg
            id="theme-moon"
            class="absolute inset-0 w-4 h-4 text-slate-700 dark:text-slate-300 origin-center transition-all duration-250 ease-out scale-100 rotate-0 opacity-100 dark:scale-0 dark:-rotate-90 dark:opacity-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </span>
      </button>

      {/* Mobile Menu Hamburger Toggle Button */}
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open main menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden p-2 rounded-xl border border-border bg-card/60 hover:bg-muted text-muted-foreground hover:text-foreground transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer active:scale-95"
      >
        <span class="sr-only">Toggle navigation menu</span>
        {/* Hamburger icon (visible when closed) */}
        <svg id="hamburger-icon" class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        {/* Close X icon (visible when open) */}
        <svg id="close-icon" class="w-4 h-4 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-border/70 bg-background/95 backdrop-blur-xl transition-all duration-300 shadow-xl"
  >
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1 text-sm font-semibold" aria-label="Mobile navigation">
      <a
        href={calcUrl}
        class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/70 active:bg-muted transition-colors"
      >
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <span>{t('nav.calc')}</span>
        </span>
        <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={subjectsUrl}
        class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/70 active:bg-muted transition-colors"
      >
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4 text-cyan-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span>{t('nav.subjects')}</span>
        </span>
        <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={tablesUrl}
        class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/70 active:bg-muted transition-colors"
      >
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4 text-amber-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{t('nav.tables')}</span>
        </span>
        <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={guidesUrl}
        class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/70 active:bg-muted transition-colors"
      >
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>{t('nav.guides')}</span>
        </span>
        <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={blogPath}
        class={`mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/70 active:bg-muted transition-colors ${
          isBlog ? 'bg-primary/10 text-primary font-bold' : ''
        }`}
      >
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>{t('nav.blog')}</span>
        </span>
        <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={faqUrl}
        class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/70 active:bg-muted transition-colors"
      >
        <span class="flex items-center gap-3">
          <svg class="w-4 h-4 text-violet-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{t('nav.faq')}</span>
        </span>
        <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      {/* Quick Resolution Badges on Mobile */}
      <div class="mt-2 pt-2.5 border-t border-border/50 flex items-center justify-around text-xs font-mono text-muted-foreground bg-muted/30 px-3 py-2 rounded-xl">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
          <span>300 DPI Print</span>
        </div>
        <span class="opacity-40">•</span>
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-glow"></span>
          <span>96 DPI Web</span>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  function initHeaderControls() {
    // Theme toggle initialization
    const toggleBtn = document.getElementById('theme-toggle-btn');
    if (toggleBtn && toggleBtn.dataset.themeInitialized !== 'true') {
      toggleBtn.dataset.themeInitialized = 'true';

      let transitionTimeout: ReturnType<typeof setTimeout> | null = null;

      const updateAria = (isDark: boolean) => {
        toggleBtn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        toggleBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      };

      // Set initial aria attribute
      updateAria(document.documentElement.classList.contains('dark'));

      const handleToggle = () => {
        const isDarkNow = document.documentElement.classList.contains('dark');
        const targetDark = !isDarkNow;

        // Enable smooth color & surface interpolation
        document.documentElement.classList.add('theme-transitioning');

        if (targetDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        try {
          localStorage.setItem('theme', targetDark ? 'dark' : 'light');
        } catch {}

        updateAria(targetDark);

        if (transitionTimeout) clearTimeout(transitionTimeout);
        transitionTimeout = setTimeout(() => {
          document.documentElement.classList.remove('theme-transitioning');
        }, 280);
      };

      toggleBtn.addEventListener('click', handleToggle);
    }

    // Mobile menu drawer initialization
    const mobileBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileBtn && mobileMenu && mobileBtn.dataset.mobileInitialized !== 'true') {
      mobileBtn.dataset.mobileInitialized = 'true';

      const openMobileMenu = () => {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        mobileBtn.setAttribute('aria-expanded', 'true');
        mobileBtn.setAttribute('aria-label', 'Close main menu');
      };

      const closeMobileMenu = () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileBtn.setAttribute('aria-label', 'Open main menu');
      };

      const toggleMobileMenu = (e: MouseEvent) => {
        e.stopPropagation();
        const isOpen = !mobileMenu.classList.contains('hidden');
        if (isOpen) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      };

      mobileBtn.addEventListener('click', toggleMobileMenu);

      // Auto-close when clicking any link inside the mobile drawer
      mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });

      // Escape key listener to close menu and refocus button
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          closeMobileMenu();
          mobileBtn.focus();
        }
      });

      // Click outside to dismiss
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target as Node) && !mobileBtn.contains(e.target as Node)) {
          if (!mobileMenu.classList.contains('hidden')) {
            closeMobileMenu();
          }
        }
      });

      // Close menu if resized above mobile breakpoint (768px)
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && !mobileMenu.classList.contains('hidden')) {
          closeMobileMenu();
        }
      });
    }
  }

  // Initialize on script load and support client-side navigations
  initHeaderControls();
  document.addEventListener('astro:page-load', initHeaderControls);
</script>
