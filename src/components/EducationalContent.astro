const printScreenComparisons = [
  { name: 'US Letter Document', inches: '8.5" × 11"', ratio: '1:1.29', px96: '816 × 1,056 px', px150: '1,275 × 1,650 px', px300: '2,550 × 3,300 px', mp300: '8.42 MP' },
  { name: 'A4 International Paper', inches: '8.27" × 11.69"', ratio: '1:1.414 (√2)', px96: '794 × 1,123 px', px150: '1,240 × 1,754 px', px300: '2,480 × 3,508 px', mp300: '8.70 MP' },
  { name: '4 × 6" Photo Print', inches: '4" × 6"', ratio: '2:3', px96: '384 × 576 px', px150: '600 × 900 px', px300: '1,200 × 1,800 px', mp300: '2.16 MP' },
  { name: '5 × 7" Framed Photo', inches: '5" × 7"', ratio: '5:7', px96: '480 × 672 px', px150: '750 × 1,050 px', px300: '1,500 × 2,100 px', mp300: '3.15 MP' },
  { name: '8 × 10" Portrait Print', inches: '8" × 10"', ratio: '4:5', px96: '768 × 960 px', px150: '1,200 × 1,500 px', px300: '2,400 × 3,000 px', mp300: '7.20 MP' },
  { name: '11 × 17" Tabloid / Ledger', inches: '11" × 17"', ratio: '11:17', px96: '1,056 × 1,632 px', px150: '1,650 × 2,550 px', px300: '3,300 × 5,100 px', mp300: '16.83 MP' },
  { name: '16 × 20" Art Poster', inches: '16" × 20"', ratio: '4:5', px96: '1,536 × 1,920 px', px150: '2,400 × 3,000 px', px300: '4,800 × 6,000 px', mp300: '28.80 MP' },
  { name: '24 × 36" Movie Poster', inches: '24" × 36"', ratio: '2:3', px96: '2,304 × 3,456 px', px150: '3,600 × 5,400 px', px300: '7,200 × 10,800 px', mp300: '77.76 MP' },
