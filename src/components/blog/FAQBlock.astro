---
/**
 * FAQBlock.astro
 * Renders a visible FAQ accordion section inside articles.
 * Schema injection is handled by BlogPost.astro layout via frontmatter.
 */

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;
---

<div class="not-prose my-10 rounded-2xl border border-border bg-card overflow-hidden shadow-sm">
  <div class="px-6 py-4 border-b border-border bg-muted/30 flex items-center gap-3">
    <span class="text-2xl">❓</span>
    <div>
      <p class="font-bold text-foreground text-base">Frequently Asked Questions</p>
      <p class="text-xs text-muted-foreground mt-0.5">People Also Ask — answers to common queries about this topic</p>
    </div>
  </div>

  <div class="divide-y divide-border/60">
    {faqs.map((faq, i) => (
      <details class="group px-6 py-0">
        <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none select-none">
          <span class="font-semibold text-foreground text-sm leading-snug pr-2">{faq.q}</span>
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-muted flex items-center justify-center transition-transform duration-200 group-open:rotate-45">
            <svg class="w-3 h-3 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 5v14M5 12h14"/>
            </svg>
          </span>
        </summary>
        <div class="pb-5 text-sm text-muted-foreground leading-relaxed [&_strong]:text-foreground [&_strong]:font-semibold [&_code]:font-mono [&_code]:text-primary [&_code]:bg-muted [&_code]:border [&_code]:border-border [&_code]:rounded [&_code]:px-1 [&_code]:text-xs">
          <p>{faq.a}</p>
        </div>
      </details>
    ))}
  </div>
</div>
