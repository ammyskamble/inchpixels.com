---
/**
 * PrivacyPolicyContent.astro
 * Privacy Policy informational content adhering to DESIGN.md tokens
 */
import { useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
---

<div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
  {/* Breadcrumb / Back Link */}
  <div class="mb-6">
    <a
      href={translatePath('/')}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors"
    >
      <span>←</span>
      <span>Back to Converter</span>
    </a>
  </div>

  {/* Header Badge & Title */}
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
      <span>Privacy & Data Protection</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
      Privacy Policy
    </h1>
    <p class="text-xs sm:text-sm text-muted-foreground mt-2">
      Effective Date: September 1, 2026 • Version 1.2
    </p>
  </div>

  {/* Content Sections */}
  <div class="space-y-8 text-sm leading-relaxed text-muted-foreground">
    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">01.</span>
        Zero Tracking & Cookie Policy
      </h2>
      <p>
        At <strong>InchPixels.com</strong>, we believe creative tools should respect your digital privacy. We do not use tracking cookies, behavioral tracking scripts, or invasive third-party analytics pixels. You can use our converters and lookup tables completely anonymously.
      </p>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">02.</span>
        100% Client-Side Calculations
      </h2>
      <p>
        All mathematical calculations—including 1D single-unit conversion, 2D canvas dimension calculations, aspect ratio visualization, and CSS/Tailwind exports—execute strictly inside your browser's local JavaScript runtime.
      </p>
      <div class="p-3.5 rounded-xl bg-muted/30 border border-border/60 text-xs font-mono text-foreground/80">
        🛡️ Privacy Guarantee: Your input values (inches, pixels, DPI settings) never leave your device and are never sent to or stored on our servers.
      </div>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">03.</span>
        Local Browser Storage Usage
      </h2>
      <p>
        We use standard browser <code class="px-1.5 py-0.5 rounded bg-muted text-foreground text-xs font-mono">localStorage</code> solely to remember your UI theme preference (Light or Dark mode). No personal data or user identifiers are ever written to browser storage.
      </p>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">04.</span>
        Server Infrastructure & Logs
      </h2>
      <p>
        Like all web applications, our hosting infrastructure automatically captures standard temporary access logs (such as IP address, user agent, requested URL, and timestamp) solely for network security, DDoS mitigation, and server performance diagnostics. These logs are automatically rotated and purged.
      </p>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">05.</span>
        Contacting Our Privacy Team
      </h2>
      <p>
        If you have any questions, clarifications, or concerns regarding this Privacy Policy, please reach out directly:
      </p>
      <div class="pt-2">
        <a
          href="mailto:privacy@inchpixels.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-colors shadow-xs"
        >
          <span>✉️</span>
          <span>privacy@inchpixels.com</span>
        </a>
      </div>
    </section>
  </div>
</div>
