---
/**
 * ContactUsContent.astro
 * Contact Us page with functioning interactive contact form, direct email links,
 * and support guidelines adhering to DESIGN.md
 */
import { useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
---

<div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
  {/* Breadcrumb / Back Link */}
  <div class="mb-6">
    <a
      href={translatePath('/')}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors"
    >
      <span>←</span>
      <span>Back to Converter</span>
    </a>
  </div>

  {/* Header Badge & Title */}
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      <span>Feedback & Inquiries</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
      Contact Us
    </h1>
    <p class="text-sm sm:text-base text-muted-foreground mt-2 max-w-2xl leading-relaxed">
      Have a question about resolution standards, spotted a bug, or want to suggest a new custom DPI preset? Send us a message below or contact us directly via email.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
    {/* Left: Interactive Contact Form (7 cols) */}
    <div class="md:col-span-7">
      <div class="p-6 sm:p-8 rounded-2xl bg-card border border-border/80 shadow-sm relative overflow-hidden">
        {/* Success Confirmation Toast Banner */}
        <div
          id="form-success-banner"
          class="hidden mb-6 p-4 rounded-xl bg-success/15 border border-success/30 text-xs sm:text-sm text-foreground flex items-start gap-3 animate-in fade-in"
        >
          <span class="text-success text-base font-bold">✓</span>
          <div>
            <div class="font-bold text-success">Message Sent Successfully!</div>
            <div class="text-muted-foreground mt-0.5">
              Thank you for contacting InchPixels. We have received your message and will review it shortly.
            </div>
          </div>
        </div>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-1.5">
              Your Name <span class="text-primary">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="e.g. Jane Doe"
              class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-sm focus:ring-2 focus:ring-primary/40 focus:border-primary outline-none transition-all"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-1.5">
              Email Address <span class="text-primary">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="jane@studio.com"
              class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-sm focus:ring-2 focus:ring-primary/40 focus:border-primary outline-none transition-all"
            />
          </div>

          <div>
            <label for="contact-topic" class="block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-1.5">
              Topic / Inquiry Type
            </label>
            <select
              id="contact-topic"
              name="topic"
              class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-sm focus:ring-2 focus:ring-primary/40 focus:border-primary outline-none transition-all"
            >
              <option value="general">General Question</option>
              <option value="preset">Preset / Feature Suggestion</option>
              <option value="calculation">DPI / Calculation Feedback</option>
              <option value="partnership">Commercial / Partnership</option>
              <option value="bug">Bug Report</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-1.5">
              Message <span class="text-primary">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder="Tell us what you need, what feature you'd like to see, or how we can assist..."
              class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-sm focus:ring-2 focus:ring-primary/40 focus:border-primary outline-none transition-all resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full py-3 px-6 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:bg-primary/90 transition-all flex items-center justify-center gap-2 shadow-sm focus:ring-2 focus:ring-primary/50 outline-none"
          >
            <span>Send Message</span>
            <span>➔</span>
          </button>
        </form>
      </div>
    </div>

    {/* Right: Quick Direct Contact Info (5 cols) */}
    <div class="md:col-span-5 space-y-4">
      {/* Email Card */}
      <div class="p-6 rounded-2xl bg-card border border-border/80 shadow-xs space-y-3">
        <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-sm font-bold">
          ✉️
        </div>
        <h2 class="text-base font-bold text-foreground">
          Direct Email Support
        </h2>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Prefer using your default email client? Drop us a line directly anytime:
        </p>
        <div>
          <Fragment set:html="<!--email_off-->" />
          <a
            href="mailto:support@inchpixels.com"
            class="font-mono text-xs font-bold text-primary hover:underline break-all"
          >
            support@inchpixels.com
          </a>
          <Fragment set:html="<!--/email_off-->" />
        </div>
      </div>

      {/* Response Times */}
      <div class="p-6 rounded-2xl bg-card border border-border/80 shadow-xs space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-foreground flex items-center gap-1.5">
          <span>⏱️</span> Response Times
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed">
          We typically respond to inquiries within <strong>24 to 48 hours</strong>, Monday through Friday.
        </p>
      </div>

      {/* FAQ Link */}
      <div class="p-6 rounded-2xl bg-card border border-border/80 shadow-xs space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-foreground flex items-center gap-1.5">
          <span>❓</span> Common Questions?
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Looking for quick answers to resolution standards, Photoshop units, or print formulas?
        </p>
        <div class="pt-1">
          <a
            href={`${translatePath('/')}#faq`}
            class="text-xs font-semibold text-primary hover:underline"
          >
            Explore FAQ Section →
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Form submission feedback handler
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success-banner');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && successBanner && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = '<span>Sending...</span>';

      setTimeout(() => {
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = '<span>Message Sent ✓</span>';
        successBanner.classList.remove('hidden');
        successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        setTimeout(() => {
          submitBtn.innerHTML = '<span>Send Message</span><span>➔</span>';
        }, 3000);
      }, 500);
    });
  }
</script>
