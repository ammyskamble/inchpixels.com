---
/**
 * TermsContent.astro
 * Terms & Conditions informational content adhering to DESIGN.md
 */
import { useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
---

<div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
  {/* Breadcrumb / Back Link */}
  <div class="mb-6">
    <a
      href={translatePath('/')}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors"
    >
      <span>←</span>
      <span>Back to Converter</span>
    </a>
  </div>

  {/* Header Badge & Title */}
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
      <span>Legal Agreements & Terms</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
      Terms & Conditions
    </h1>
    <p class="text-xs sm:text-sm text-muted-foreground mt-2">
      Last Updated: September 1, 2026 • Version 1.1
    </p>
  </div>

  {/* Terms Sections */}
  <div class="space-y-8 text-sm leading-relaxed text-muted-foreground">
    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">01.</span>
        Acceptance of Terms
      </h2>
      <p>
        By accessing and using <strong>InchPixels.com</strong>, you acknowledge that you have read, understood, and agree to be bound by these Terms & Conditions. If you do not agree with any part of these terms, please discontinue using the service.
      </p>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">02.</span>
        Free Commercial & Personal License
      </h2>
      <p>
        InchPixels grants you a free, perpetual, non-exclusive license to use the conversion calculation tools, reference lookup tables, and exported code snippets (such as CSS declarations, Tailwind CSS v4 class names, and SVG markup) in your personal, educational, and commercial graphic design or web development projects without attribution requirements.
      </p>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">03.</span>
        Mathematical Accuracy & Prepress Disclaimer
      </h2>
      <p>
        While all mathematical conversions strictly adhere to published W3C digital screen specifications (1 inch = 96 CSS pixels) and international commercial printing standards (300 DPI), physical print equipment tolerances, printer driver interpolation, and paper shrink factors can slightly vary output.
      </p>
      <div class="p-3.5 rounded-xl bg-muted/30 border border-border/60 text-xs text-foreground/80">
        ⚠️ Prepress Recommendation: Always verify bleed, crop margins, and final physical dimensions with your commercial printing service provider before large print production runs.
      </div>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">04.</span>
        Limitation of Liability
      </h2>
      <p>
        InchPixels is provided "as is" and "as available" without warranties of any kind. Under no circumstances shall InchPixels.com or its maintainers be liable for any direct, indirect, incidental, or consequential damages resulting from the use of calculation figures or code snippets generated through the site.
      </p>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-3">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">05.</span>
        Questions Regarding Terms
      </h2>
      <p>
        For inquiries regarding commercial licensing or terms clarification, please contact our legal team:
      </p>
      <div class="pt-1">
        <Fragment set:html="<!--email_off-->" />
        <a
          href="mailto:legal@inchpixels.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-colors shadow-xs"
        >
          <span>✉️</span>
          <span>legal@inchpixels.com</span>
        </a>
        <Fragment set:html="<!--/email_off-->" />
      </div>
    </section>
  </div>
</div>
