---
/**
 * AboutUsContent.astro
 * Informational About Us content matching DESIGN.md
 */
import { useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
---

<div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
  {/* Breadcrumb / Back Link */}
  <div class="mb-6">
    <a
      href={translatePath('/')}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors"
    >
      <span>←</span>
      <span>Back to Converter</span>
    </a>
  </div>

  {/* Header Badge & Title */}
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      <span>Our Mission & Architecture</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
      About InchPixels
    </h1>
    <p class="text-sm sm:text-base text-muted-foreground mt-3 max-w-2xl leading-relaxed">
      Precision engineering meets modern creative workflows. Built from the ground up for UI/UX designers, printmakers, digital photographers, and frontend developers.
    </p>
  </div>

  {/* Main Story Cards */}
  <div class="space-y-8 text-sm leading-relaxed text-muted-foreground">
    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-4">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">💡</span>
        Why We Built InchPixels
      </h2>
      <p>
        Existing online unit converters were either cluttered with intrusive advertisements, lacked real-time synchronization, or only handled simple one-dimensional numbers without considering 2D print dimensions, aspect ratios, or modern frontend frameworks.
      </p>
      <p>
        We designed <strong>InchPixels.com</strong> to bridge the physical print world and the digital screen world with zero friction:
      </p>

      {/* Feature Highlights Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        <div class="p-4 rounded-xl bg-muted/20 border border-border/60">
          <div class="font-bold text-foreground text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
            <span>⚡</span> Real-Time Bi-Directional Engine
          </div>
          <p class="text-xs text-muted-foreground">
            Instantly converts Inches ➔ Pixels and Pixels ➔ Inches across 1D vectors and 2D canvas layouts without page reloads.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-muted/20 border border-border/60">
          <div class="font-bold text-foreground text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
            <span>🖨️</span> Industry Resolution Presets
          </div>
          <p class="text-xs text-muted-foreground">
            Accurately tuned for 72 DPI (legacy), 96 DPI (W3C web standard), 150 DPI (newsprint), 300 DPI (commercial offset), and 600 DPI (giclée).
          </p>
        </div>

        <div class="p-4 rounded-xl bg-muted/20 border border-border/60">
          <div class="font-bold text-foreground text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
            <span>📐</span> Live Aspect Ratio Visualizer
          </div>
          <p class="text-xs text-muted-foreground">
            Dynamic SVG preview showing proportional canvas boundaries, orientation indicators, and megapixel counts in real time.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-muted/20 border border-border/60">
          <div class="font-bold text-foreground text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
            <span>💻</span> Pro Developer & Designer Export
          </div>
          <p class="text-xs text-muted-foreground">
            One-click copy for Raw PX, CSS declaration, Tailwind CSS v4 arbitrary classes, print <code class="text-primary font-mono">@page</code> rules, and SVG viewBox.
          </p>
        </div>
      </div>
    </section>

    <section class="p-6 rounded-2xl bg-card border border-border/80 space-y-4">
      <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
        <span class="text-primary font-mono text-sm">🌐</span>
        Global Accessibility & Open Standards
      </h2>
      <p>
        InchPixels is natively localized into 8 major languages (English, Spanish, Japanese, French, German, Portuguese, Korean, and Italian) to support international studios, prepress print shops, and design systems worldwide.
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        <a
          href={translatePath('/')}
          class="px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-colors shadow-xs"
        >
          Launch Free Converter
        </a>
        <a
          href={translatePath('/contact-us')}
          class="px-4 py-2 rounded-xl bg-muted/60 hover:bg-muted border border-border/60 text-foreground text-xs font-semibold transition-colors"
        >
          Send Us Feedback
        </a>
      </div>
    </section>
  </div>
</div>
